# ─── Workestra Local Development ───
# Copy to .env.local for local development

# Database
DATABASE_URL=postgresql://workestra:workestra_secret@localhost:5432/workestra

# Redis
REDIS_URL=redis://:redis_secret@localhost:6379

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=workestra
KEYCLOAK_CLIENT_ID=workestra-portal
KEYCLOAK_CLIENT_SECRET=
REDIRECT_URI=http://localhost:3000/auth/callback

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=workestra
MINIO_SECRET_KEY=minio_secret_key
MINIO_BUCKET=workestra-documents

# OpenSearch
OPENSEARCH_URL=http://localhost:9200

# Tika
TIKA_URL=http://localhost:9998

# Camunda / Zeebe
ZEEBE_ADDRESS=localhost:26500

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Application
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Next.js Public
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=workestra
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=workestra-portal
