# ─── Workestra Local Development ───
# Copy to .env.local for local development

# Database
DATABASE_URL=postgresql://workestra:workestra_secret@localhost:5432/workestra

# Redis
REDIS_URL=redis://:redis_secret@localhost:6379

# JWT
JWT_SECRET=change-me-to-a-random-secret

# LDAP (optional — if not configured, only local users work)
LDAP_URL=ldap://localhost:389
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=admin_password
LDAP_SEARCH_BASE=ou=users,dc=example,dc=com
LDAP_SEARCH_FILTER=(uid={{username}})

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=workestra
MINIO_SECRET_KEY=minio_secret_key
MINIO_BUCKET=workestra-documents
MINIO_USE_SSL=false

# OpenSearch (optional — Postgres full-text search is used by default)
OPENSEARCH_URL=http://localhost:9200

# Tika (optional — used for document content extraction)
TIKA_URL=http://localhost:9998

# Camunda / Zeebe (optional — workflow engine)
ZEEBE_ADDRESS=localhost:26500

# VAPID keys for push notifications (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@workestra.local

# SMTP (optional — for email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@workestra.local

# Application
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Next.js Public
NEXT_PUBLIC_API_URL=http://localhost:4000
