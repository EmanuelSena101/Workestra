# ─── Workestra Environment Variables ───
# Copy this file to .env and adjust values for your deployment

# ── PostgreSQL ──
POSTGRES_USER=workestra
POSTGRES_PASSWORD=workestra_secret
POSTGRES_DB=workestra

# ── Redis ──
REDIS_PASSWORD=redis_secret

# ── Keycloak ──
KEYCLOAK_DB=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=workestra
KEYCLOAK_CLIENT_ID=workestra-portal
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# ── MinIO ──
MINIO_ROOT_USER=workestra
MINIO_ROOT_PASSWORD=minio_secret_key
MINIO_BUCKET=workestra-documents

# ── SMTP ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Application ──
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
