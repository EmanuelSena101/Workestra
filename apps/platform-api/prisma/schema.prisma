generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users & Identity ──

model User {
  id          String   @id @default(uuid())
  ldapDn      String?  @unique @map("ldap_dn")
  username    String   @unique
  email       String   @unique
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  displayName String   @map("display_name")
  avatar      String?
  passwordHash String? @map("password_hash")
  active      Boolean  @default(true)
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  groups            UserGroup[]
  documents         Document[]
  folders           Folder[]
  notifications     Notification[]
  auditEntries      AuditEntry[]
  comments          Comment[]
  pushSubscriptions PushSubscription[]
  assignedCards     KanbanCard[]       @relation("CardAssignee")
  createdCards      KanbanCard[]       @relation("CardCreator")
  requestsCreated   Request[]

  @@map("users")
}

model Group {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  ldapDn      String?  @unique @map("ldap_dn")
  parentId    String?  @map("parent_id")
  parent      Group?   @relation("GroupHierarchy", fields: [parentId], references: [id])
  children    Group[]  @relation("GroupHierarchy")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members     UserGroup[]

  @@map("groups")
}

model UserGroup {
  userId  String @map("user_id")
  groupId String @map("group_id")
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@map("user_groups")
}

// ── Permissions / ACL ──

model Permission {
  id          String   @id @default(uuid())
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  subjectType String   @map("subject_type") // user | group | role
  subjectId   String   @map("subject_id")
  actions     String[] // read, write, delete, admin, publish
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([subjectType, subjectId])
  @@map("permissions")
}

// ── Documents / ECM ──

model Document {
  id          String   @id @default(uuid())
  name        String
  description String?
  folderId    String?  @map("folder_id")
  folder      Folder?  @relation(fields: [folderId], references: [id])
  mimeType    String   @map("mime_type")
  size        BigInt
  version     Int      @default(1)
  storageKey  String   @map("storage_key")
  tags        String[]
  extractedText String? @map("extracted_text") @db.Text
  publishedAt DateTime? @map("published_at")
  createdById String   @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  metadata    DocumentMetadata[]
  versions    DocumentVersion[]

  @@index([folderId])
  @@index([createdById])
  @@map("documents")
}

model DocumentMetadata {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  key        String
  value      String

  @@unique([documentId, key])
  @@map("document_metadata")
}

model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    Int
  size       BigInt
  storageKey String   @map("storage_key")
  mimeType   String   @map("mime_type") @default("application/octet-stream")
  comment    String?
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([documentId, version])
  @@map("document_versions")
}

model Folder {
  id          String   @id @default(uuid())
  name        String
  description String?
  parentId    String?  @map("parent_id")
  parent      Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children    Folder[] @relation("FolderHierarchy")
  createdById String   @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  documents   Document[]

  @@index([parentId])
  @@map("folders")
}

// ── Process / Workflow Tracking ──

model ProcessDefinition {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  category    String?
  version     Int      @default(1)
  formKey     String?  @map("form_key")
  bpmnXml     String?  @map("bpmn_xml") @db.Text
  deployed    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  requests    Request[]
  kanbanBoard KanbanBoard?

  @@map("process_definitions")
}

model Request {
  id                   String   @id @default(uuid())
  processInstanceId    String?  @map("process_instance_id")
  processDefinitionId  String   @map("process_definition_id")
  processDefinition    ProcessDefinition @relation(fields: [processDefinitionId], references: [id])
  requestNumber        String   @unique @map("request_number")
  title                String
  description          String?
  requesterId          String   @map("requester_id")
  requester            User     @relation(fields: [requesterId], references: [id])
  status               String   @default("draft") // draft, open, in_progress, completed, cancelled
  priority             String   @default("medium") // low, medium, high, critical
  currentStep          String?  @map("current_step")
  formData             Json?    @map("form_data")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  completedAt          DateTime? @map("completed_at")

  attachments          Attachment[]
  comments             Comment[]
  history              HistoryEntry[]

  @@index([requesterId])
  @@index([status])
  @@map("requests")
}

model Attachment {
  id         String   @id @default(uuid())
  requestId  String?  @map("request_id")
  request    Request? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  name       String
  mimeType   String   @map("mime_type")
  size       BigInt
  storageKey String   @map("storage_key")
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("attachments")
}

// ── Tasks (local tracking) ──

model Task {
  id                   String   @id @default(uuid())
  externalId           String?  @unique @map("external_id") // Camunda task ID
  title                String
  description          String?
  processName          String?  @map("process_name")
  processDefinitionKey String?  @map("process_definition_key")
  currentStep          String?  @map("current_step")
  assigneeId           String?  @map("assignee_id")
  status               String   @default("pending") // pending, in_progress, completed, overdue
  priority             String   @default("medium") // low, medium, high, critical
  slaPercentage        Int      @default(0) @map("sla_percentage")
  dueDate              DateTime? @map("due_date")
  completedAt          DateTime? @map("completed_at")
  formData             Json?    @map("form_data")
  requestId            String?  @map("request_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([assigneeId])
  @@index([status])
  @@map("tasks")
}

// ── Forms ──

model FormDefinition {
  id                   String   @id @default(uuid())
  name                 String
  processDefinitionKey String?  @map("process_definition_key")
  version              Int      @default(1)
  fields               Json
  layout               Json?
  createdBy            String   @map("created_by")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("form_definitions")
}

// ── Datasets ──

model DatasetDefinition {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  sourceType  String   @map("source_type") // internal, rest, soap, sql, erp
  config      Json
  fields      Json
  cacheTtl    Int?     @map("cache_ttl") // seconds
  lastSyncAt  DateTime? @map("last_sync_at")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("dataset_definitions")
}

// ── Notifications ──

model Notification {
  id        String   @id @default(uuid())
  type      String   // task_assigned, task_completed, request_updated, document_shared, system
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")

  @@index([userId, read])
  @@map("notifications")
}

// ── Push Subscriptions ──

model PushSubscription {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("push_subscriptions")
}

// ── Kanban ──

model KanbanBoard {
  id                   String   @id @default(uuid())
  name                 String
  description          String?
  processDefinitionId  String?  @unique @map("process_definition_id")
  processDefinition    ProcessDefinition? @relation(fields: [processDefinitionId], references: [id])
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  columns              KanbanColumn[]

  @@map("kanban_boards")
}

model KanbanColumn {
  id       String   @id @default(uuid())
  boardId  String   @map("board_id")
  board    KanbanBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name     String
  position Int
  color    String?
  createdAt DateTime @default(now()) @map("created_at")

  cards    KanbanCard[]

  @@index([boardId])
  @@map("kanban_columns")
}

model KanbanCard {
  id          String   @id @default(uuid())
  columnId    String   @map("column_id")
  column      KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  title       String
  description String?
  position    Int
  priority    String   @default("medium") // low, medium, high, critical
  assigneeId  String?  @map("assignee_id")
  assignee    User?    @relation("CardAssignee", fields: [assigneeId], references: [id])
  createdById String   @map("created_by_id")
  createdBy   User     @relation("CardCreator", fields: [createdById], references: [id])
  requestId   String?  @map("request_id")
  dueDate     DateTime? @map("due_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([columnId])
  @@map("kanban_cards")
}

// ── Audit ──

model AuditEntry {
  id         String   @id @default(uuid())
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  userName   String   @map("user_name")
  details    Json?
  ipAddress  String?  @map("ip_address")
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([timestamp])
  @@map("audit_entries")
}

// ── Comments ──

model Comment {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  requestId  String?  @map("request_id")
  request    Request? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  authorId   String   @map("author_id")
  author     User     @relation(fields: [authorId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@index([entityType, entityId])
  @@map("comments")
}

// ── History ──

model HistoryEntry {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  requestId  String?  @map("request_id")
  request    Request? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  action     String
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  userId     String   @map("user_id")
  userName   String   @map("user_name")
  details    Json?
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("history_entries")
}

// ── Portals ──

model Portal {
  id          String   @id @default(uuid())
  name        String
  slug        String?
  description String?
  status      String   @default("draft") // draft, published
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pages       PortalPage[]

  @@map("portals")
}

model PortalPage {
  id       String @id @default(uuid())
  portalId String @map("portal_id")
  portal   Portal @relation(fields: [portalId], references: [id], onDelete: Cascade)
  title    String
  slug     String
  content  Json?
  position Int    @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([portalId])
  @@map("portal_pages")
}

// ── Communities ──

model Community {
  id          String   @id @default(uuid())
  name        String
  description String?
  memberCount Int      @default(0) @map("member_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  posts       CommunityPost[]

  @@map("communities")
}

model CommunityPost {
  id          String    @id @default(uuid())
  communityId String    @map("community_id")
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  title       String
  content     String    @db.Text
  authorId    String    @map("author_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([communityId])
  @@map("community_posts")
}

// ── Integration Config ──

model IntegrationConfig {
  id          String   @id @default(uuid())
  name        String   @unique
  type        String   // rest, soap, sql, erp, webhook, mattermost, google_chat
  config      Json
  active      Boolean  @default(true)
  lastTestedAt DateTime? @map("last_tested_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("integration_configs")
}

// ── Announcements ──

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  type      String   @default("info") // info, warning, critical
  active    Boolean  @default(true)
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("announcements")
}

// ── Favorites ──

model Favorite {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  entityType String   @map("entity_type") // process, document, folder, portal
  entityId   String   @map("entity_id")
  label      String
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, entityType, entityId])
  @@map("favorites")
}
