{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2021",
    "outDir": "./dist",
    "rootDir": "./src",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "paths": {
      "@/*": ["./src/*"],
      "@workestra/shared-types": ["../../packages/shared-types/src"],
      "@workestra/workflow-schema": ["../../packages/workflow-schema/src"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "test"]
}
